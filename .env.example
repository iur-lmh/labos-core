# =============================================================================
# labos-core — copiar a .env y personalizar
# =============================================================================

# Aplicación
PROJECT_NAME=LabOS API
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Solo desarrollo: crea tablas sin Alembic. En producción usar migraciones.
AUTO_CREATE_TABLES=false

# Seguridad — generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-with-a-random-48-byte-string-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Base de datos PostgreSQL 16
DATABASE_URL=postgresql+psycopg://labos:labos_dev_password@localhost:5432/labos
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# Administrador inicial (se crea solo si no hay usuarios)
ADMIN_EMAIL=admin@labos.ar
ADMIN_PASSWORD=LabosAdmin123!
ADMIN_NOMBRE=Administrador LabOS

# Object storage S3-compatible (Cloudflare R2, MinIO o s3mock local)
# Local: http://localhost:9090 con el perfil "storage" de docker compose
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=labos-archivos
S3_REGION=auto

# Límites
MAX_DATOS_RAW_BYTES=1000000
MAX_ARCHIVO_BYTES=524288000
